<?xml version="1.0" encoding="UTF-8"?>
<server description="new server">

    <!-- Enable features -->
    <featureManager>
        <feature>jakartaee-11.0</feature>
        <feature>microProfile-7.1</feature>
        <feature>jdbc-4.3</feature>
        <feature>persistence-3.2</feature>
        <feature>data</feature>
        <feature>localConnector-1.0</feature>
        <feature>jwt-1.0</feature> <!-- Added by TJ for jwt config -->
    </featureManager>

    <!--
    <keyStore password=""/>
    -->

    <!-- Empty on purpose. jakartaee-11.0 requires a registry. Real users live in the database and log in with JWT. -->
    <basicRegistry id="basic" realm="BasicRealm">
    </basicRegistry>

    <!-- JWT: builder signs tokens with auto-generated keys; mpJwt validates them -->
    <jwtBuilder
            id="myBuilder"
            issuer="${jwt.issuer}"
            expiry="1h"
            signatureAlgorithm="RS256"
            jwkEnabled="true"
    />
    <mpJwt
            id="myMpJwt"
            issuer="${jwt.issuer}"
            jwksUri="https://localhost:${https.port}/jwt/ibm/api/myBuilder/jwk"
    />

    <!-- To access this server from a remote client add a host attribute to the following element, e.g. host="*" -->
    <httpEndpoint id="defaultHttpEndpoint"

                  httpPort="${http.port}"
                  httpsPort="${https.port}"
    />

    <!-- Automatically expand WAR files and EAR files -->
    <applicationManager autoExpand="true"/>

    <!-- Configures the application on a specified context root -->
    <webApplication contextRoot="${app.context.root}" location="gift-app.war" />

    <!-- Default SSL configuration enables trust for default certificates from the Java runtime -->
    <ssl id="defaultSSLConfig" trustDefaultCerts="true" />

    <!--  a library for the PostgreSQL JDBC driver and configure a data source -->
    <library id="PostgreSQL">
        <fileset dir="${shared.resource.dir}" includes="postgresql-*.jar"/>
    </library>



    <dataSource jndiName="jdbc/giftapp">
        <jdbcDriver libraryRef="PostgreSQL"/>
        <properties.postgresql
                serverName="ep-icy-silence-aywepsgr-pooler.c-5.us-east-2.aws.neon.tech"
                portNumber="5432"
                databaseName="neondb"
                user="neondb_owner"
                password="${env.POSTGRES_PASSWORD}"
                sslmode="require"/>
    </dataSource>
    <cors
            domain="/gift-app"
            allowedOrigins="${cors.allowed.domain}"
            allowedMethods="GET, POST, PUT, DELETE, OPTIONS"
            allowCredentials="true"
            allowedHeaders="Authorization, Content-Type"
    />
</server>
